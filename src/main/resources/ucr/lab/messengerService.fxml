<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="666.0" prefWidth="854.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MessengerController">
    <children>
        <Pane layoutX="103.0" layoutY="57.0" prefHeight="114.0" prefWidth="860.0" style="-fx-background-color: #E87C1D;">
            <children>
                <Label layoutX="234.0" layoutY="28.0" prefHeight="73.0" prefWidth="551.0" text="Messenger Service (Priority Queue)">
                    <font>
                        <Font name="Bookman Old Style Bold" size="29.0" />
                    </font>
                </Label>
            </children></Pane>
        <Pane layoutX="103.0" layoutY="171.0" prefHeight="571.0" prefWidth="860.0" style="-fx-background-color: #3A9F88;">
            <children>
                <Label layoutX="145.0" layoutY="6.0" prefHeight="85.0" prefWidth="178.0" text="How many messages?">
               <font>
                  <Font name="Bookman Old Style" size="14.0" />
               </font></Label>
                <TextField fx:id="txf_totalMessage" layoutX="300.0" layoutY="36.0" />
                <Label layoutX="640.0" layoutY="40.0" text="Between 100 and 500 value">
               <font>
                  <Font name="Bookman Old Style" size="14.0" />
               </font></Label>
                <Button fx:id="btn_Start" layoutX="249.0" layoutY="78.0" mnemonicParsing="false" onAction="#startOnAction" prefHeight="49.0" prefWidth="109.0" text="Start" />
                <Button fx:id="btn_Clean" layoutX="408.0" layoutY="77.0" mnemonicParsing="false" onAction="#cleanOnAction" prefHeight="49.0" prefWidth="109.0" text="Clean" />
                <Pane layoutX="1.0" layoutY="133.0" prefHeight="438.0" prefWidth="860.0" style="-fx-background-color: #2AD6F1;">
                    <children>
                        <Label layoutX="520.0" layoutY="10.0" prefHeight="49.0" prefWidth="95.0" text="DeQueue">
                     <font>
                        <Font name="Bookman Old Style" size="14.0" />
                     </font></Label>
                        <Label layoutX="66.0" layoutY="4.0" prefHeight="61.0" prefWidth="121.0" text="EnQueue">
                     <font>
                        <Font name="Bookman Old Style" size="14.0" />
                     </font></Label>
                        <TextArea fx:id="txa_Enqueue" editable="false" layoutX="20.0" layoutY="59.0" prefHeight="360.0" prefWidth="357.0" />
                        <TextArea fx:id="txa_Dequeue" editable="false" layoutX="445.0" layoutY="57.0" prefHeight="364.0" prefWidth="387.0" />
                    </children></Pane>
            </children>
        </Pane>
    </children>
</AnchorPane>
